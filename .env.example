# ==============================================================================
# KPC FlowGuard Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql+psycopg2://flowguard:flowguard@localhost:5432/flowguard

# ETL & Data Pipeline Paths
SOURCE_DATA_DIR=synthetic_flowguard_data
QUARANTINE_DIR=etl/quarantine
REPORTS_DIR=data_quality/reports

# Backend Server & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
# Allowed frontend origin for CORS (e.g. https://flowguard-frontend.onrender.com)
FRONTEND_URL=http://localhost:3000

# Frontend Next.js API Connection
# Set to 'api' to connect to live FastAPI backend, or 'synthetic' for in-memory demo
NEXT_PUBLIC_FLOWGUARD_DATA_MODE=synthetic
NEXT_PUBLIC_FLOWGUARD_API_URL=http://localhost:8000
# Alternative shorter alias also supported:
NEXT_PUBLIC_API_URL=http://localhost:8000

